{% extends "base.html.twig" %}
{% block title %}{{ article.title }} - Tech Blog{% endblock %}
{% block body %}
<article>
<h2>{{ article.title }}</h2>
{% if article.categories %}
<div style="margin: 1rem 0;"><strong>Catégories :</strong>
{% for categorie in article.categories %}<span style="background-color: #f0f0f0; padding: 0.3rem 0.6rem; margin-right: 0.5rem; border-radius: 3px;">{{ categorie.name }}</span>{% endfor %}</div>
{% endif %}
<div style="background-color: #f9f9f9; padding: 1.5rem; border-radius: 5px; margin: 1.5rem 0;">{{ article.content }}</div>
<a href="{{ path('app_home') }}" style="display: inline-block; margin-bottom: 2rem; background-color: #666; color: white; padding: 0.5rem 1rem; text-decoration: none; border-radius: 3px;">← Retour aux articles</a>
</article>
<section style="margin-top: 3rem;">
<h3>Commentaires ({{ article.commentaires|length }})</h3>
{% if article.commentaires %}
<div class="commentaires-list">
{% for commentaire in article.commentaires %}
<div style="border-left: 4px solid #333; padding: 1rem; margin: 1rem 0; background-color: #f9f9f9;">
<strong>{{ commentaire.username }}</strong>
<em style="color: #999; display: block; font-size: 0.9rem;">{{ commentaire.createdAt|date('d/m/Y à H:i') }}</em>
<p style="margin-top: 0.5rem;">{{ commentaire.content }}</p>
</div>
{% endfor %}
</div>
{% else %}
<p>Aucun commentaire pour le moment.</p>
{% endif %}
<h4 style="margin-top: 2rem;">Ajouter un commentaire</h4>
{{ form_start(formulaire) }}{{ form_widget(formulaire) }}<button type="submit" style="background-color: #333; color: white; padding: 0.7rem 1.5rem; border: none; border-radius: 3px; cursor: pointer; margin-top: 1rem;">Poster un commentaire</button>{{ form_end(formulaire) }}
</section>
{% endblock %}
