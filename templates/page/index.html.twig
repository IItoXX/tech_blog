{% extends "base.html.twig" %}

{% block title %}Accueil - Tech Blog{% endblock %}

{% block body %}
    <h2>Bienvenue sur Tech Blog</h2>
    <p>Découvrez nos articles sur l'informatique, le développement et l'administration serveur.</p>

    <h3>Articles récents</h3>

    {% if posts %}
        <div class="posts-list">
            {% for post in posts %}
                <article class="post-card" style="border: 1px solid #ddd; padding: 1rem; margin: 1rem 0; border-radius: 5px;">
                    <h4><a href="{{ path('app_post_show', {'id': post.id}) }}" style="text-decoration: none; color: #333;">{{ post.title }}</a></h4>
                    <p>{{ post.content|length > 100 ? post.content|slice(0, 100) ~ '...' : post.content }}</p>

                    {% if post.categories %}
                        <div style="margin-top: 0.5rem;">
                            <strong>Catégories :</strong>
                            {% for category in post.categories %}
                                <span style="background-color: #f0f0f0; padding: 0.3rem 0.6rem; margin-right: 0.5rem; border-radius: 3px;">{{ category.name }}</span>
                            {% endfor %}
                        </div>
                    {% endif %}

                    <a href="{{ path('app_post_show', {'id': post.id}) }}" style="display: inline-block; margin-top: 1rem; background-color: #333; color: white; padding: 0.5rem 1rem; text-decoration: none; border-radius: 3px;">Lire plus</a>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <p>Aucun article pour le moment.</p>
    {% endif %}
{% endblock %}
