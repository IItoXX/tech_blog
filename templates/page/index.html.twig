{% extends "base.html.twig" %}
{% block title %}Accueil - Tech Blog{% endblock %}
{% block body %}
<h2>Bienvenue sur Tech Blog</h2>
<p>rrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr</p>
<h3>Articles récents</h3>
{% if articles %}
<div class="articles-list">
{% for article in articles %}
<article class="article-card" style="border: 1px solid #ddd; padding: 1rem; margin: 1rem 0; border-radius: 5px;">
<h4><a href="{{ path('app_post_show', {'id': article.id}) }}" style="text-decoration: none; color: #333;">{{ article.title }}</a></h4>
<p>{{ article.content|length > 100 ? article.content|slice(0, 100) ~ '...' : article.content }}</p>
{% if article.categories %}
<div style="margin-top: 0.5rem;"><strong>Catégories :</strong>
{% for categorie in article.categories %}<span style="background-color: #f0f0f0; padding: 0.3rem 0.6rem; margin-right: 0.5rem; border-radius: 3px;">{{ categorie.name }}</span>{% endfor %}</div>
{% endif %}
<a href="{{ path('app_post_show', {'id': article.id}) }}" style="display: inline-block; margin-top: 1rem; background-color: #333; color: white; padding: 0.5rem 1rem; text-decoration: none; border-radius: 3px;">Lire plus</a>
</article>
{% endfor %}
</div>
{% else %}
<p>Aucun article pour le moment.</p>
{% endif %}
{% endblock %}
