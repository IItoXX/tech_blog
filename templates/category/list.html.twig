{% extends "base.html.twig" %}
{% block title %}Catégories - Tech Blog{% endblock %}
{% block body %}
<h2>Catégories</h2>
<p>Découvrez nos catégories d'articles.</p>
{% if categories %}
<div class="categories-list">
{% for categorie in categories %}
<div class="category-card" style="border: 1px solid #ddd; padding: 1rem; margin: 1rem 0; border-radius: 5px;">
<h3><a href="{{ path('app_category_show', {'id': categorie.id}) }}" style="text-decoration: none; color: #333;">{{ categorie.name }}</a></h3>
<p>{{ categorie.posts|length }} article(s)</p>
<a href="{{ path('app_category_show', {'id': categorie.id}) }}" style="display: inline-block; background-color: #333; color: white; padding: 0.5rem 1rem; text-decoration: none; border-radius: 3px;">Voir les articles</a>
</div>
{% endfor %}
</div>
{% else %}
<p>Aucune catégorie pour le moment.</p>
{% endif %}
{% endblock %}