{% extends "base.html.twig" %}
{% block title %}{{ categorie.name }} - Tech Blog{% endblock %}
{% block body %}
<h2>{{ categorie.name }}</h2>
<a href="{{ path('app_categories_list') }}" style="display: inline-block; margin-bottom: 2rem; background-color: #666; color: white; padding: 0.5rem 1rem; text-decoration: none; border-radius: 3px;">← Retour aux catégories</a>
<h3>Articles dans cette catégorie ({{ categorie.posts|length }})</h3>
{% if categorie.posts|length > 0 %}
<div class="articles-list">
{% for article in categorie.posts %}
<article class="article-card" style="border: 1px solid #ddd; padding: 1rem; margin: 1rem 0; border-radius: 5px;">
<h4><a href="{{ path('app_post_show', {'id': article.id}) }}" style="text-decoration: none; color: #333;">{{ article.title }}</a></h4>
<p>{{ article.content|length > 100 ? article.content|slice(0, 100) ~ '...' : article.content }}</p>
<a href="{{ path('app_post_show', {'id': article.id}) }}" style="display: inline-block; margin-top: 1rem; background-color: #333; color: white; padding: 0.5rem 1rem; text-decoration: none; border-radius: 3px;">Lire plus</a>
</article>
{% endfor %}
</div>
{% else %}
<p>Aucun article dans cette catégorie.</p>
{% endif %}
{% endblock %}